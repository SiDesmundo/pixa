# NPC dialogue AI provider. Optional - if omitted, defaults to "anthropic"
# when ANTHROPIC_API_KEY is set below, otherwise falls back to "ollama"
# (local, free, no key needed - requires Ollama running on this machine).
# AI_PROVIDER=ollama

# --- Anthropic (used when AI_PROVIDER=anthropic, or auto-selected if set) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# optional, defaults to claude-haiku-4-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Ollama (local, free - used by default when no Anthropic key is set) ---
# Prefixed with PIXA_ to avoid colliding with Ollama's own OLLAMA_HOST env var
# (which configures the Ollama server's bind address, not a client URL).
# optional, defaults to llama3.1:8b
# PIXA_OLLAMA_MODEL=llama3.1:8b
# optional, defaults to http://localhost:11434
# PIXA_OLLAMA_HOST=http://localhost:11434
